# Normalização de fim de linha. Scripts executados em container precisam de LF.
* text=auto eol=lf

*.sh            text eol=lf
entrypoint.sh   text eol=lf
Makefile        text eol=lf
Dockerfile      text eol=lf
*.ps1           text eol=crlf

*.png binary
*.jpg binary
*.xlsx binary
*.xls binary
*.pdf binary
*.ico binary
