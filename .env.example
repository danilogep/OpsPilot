# ============================================================
# OpsPilot — exemplo de configuração. Copie para .env e ajuste.
# NUNCA comite o arquivo .env. Nenhum valor abaixo é um segredo real.
# Todas as variáveis do backend usam o prefixo OPSPILOT_.
# ============================================================

# --- Aplicação ---
OPSPILOT_APP_NAME=OpsPilot
OPSPILOT_ENVIRONMENT=local            # local | staging | production
OPSPILOT_DEBUG=true
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_LOG_JSON=false               # true em produção

# --- Banco de dados (PostgreSQL 16) ---
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot_local_dev_only
POSTGRES_DB=opspilot
OPSPILOT_DATABASE_URL=postgresql+asyncpg://opspilot:opspilot_local_dev_only@db:5432/opspilot
# Execução local sem Docker (SQLite, sem FTS nativo):
# OPSPILOT_DATABASE_URL=sqlite+aiosqlite:///./opspilot.db

# --- Segurança / JWT ---
# Gere um valor próprio: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPSPILOT_JWT_SECRET=troque-este-valor-em-qualquer-ambiente-real
OPSPILOT_JWT_ALGORITHM=HS256
OPSPILOT_ACCESS_TOKEN_EXPIRE_MINUTES=60
OPSPILOT_CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:8080"]

# --- Uploads ---
OPSPILOT_UPLOAD_DIR=./var/uploads
OPSPILOT_MAX_UPLOAD_MB=20

# --- Seed de demonstração (apenas ambiente local) ---
OPSPILOT_DEMO_ORG_NAME=Acme Serviços Ltda
OPSPILOT_DEMO_PASSWORD=OpsPilot!2026

# --- Provider de IA ---
# mock é o padrão e não requer nenhuma chave. Os demais são opcionais.
OPSPILOT_LLM_PROVIDER=mock            # mock | anthropic | openai | gemini
OPSPILOT_LLM_MODEL=                   # vazio = modelo padrão do provider
OPSPILOT_LLM_TIMEOUT_SECONDS=30
OPSPILOT_LLM_MAX_RETRIES=2
OPSPILOT_LLM_MAX_OUTPUT_TOKENS=1200
# OPSPILOT_ANTHROPIC_API_KEY=
# OPSPILOT_OPENAI_API_KEY=
# OPSPILOT_GEMINI_API_KEY=

# --- Embeddings (opcional; a busca obrigatória é textual) ---
OPSPILOT_EMBEDDINGS_PROVIDER=none     # none | mock | openai

# --- Webhooks / n8n ---
OPSPILOT_WEBHOOK_SECRET=opspilot_webhook_demo_secret
OPSPILOT_WEBHOOK_OUTBOUND_URL=        # ex.: http://n8n:5678/webhook/opspilot
OPSPILOT_WEBHOOK_TIMEOUT_SECONDS=10

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000

# --- n8n (profile opcional do docker compose) ---
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=opspilot
N8N_BASIC_AUTH_PASSWORD=opspilot_local_dev_only
